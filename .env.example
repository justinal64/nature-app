# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# iNaturalist OAuth (Authorization Code + PKCE) — powers the online
# Computer Vision identification path (score_image) as the DEFAULT
# identifier, with the on-device TFLite model as offline/failure fallback.
# See Obsidian: decision-identification-online-api.
#
# Register a *non-confidential* OAuth application yourself at
# https://www.inaturalist.org/oauth/applications/new — set Redirect URI to
# exactly `wildlens://oauth-callback` and leave "Confidential" unchecked
# (PKCE covers the security gap; there's no usable client secret for a
# public/native client). This is a one-time per-developer setup step, not a
# secret value. Leave blank to disable the "Connect iNaturalist account"
# flow and always use the on-device fallback.
#
# Per-user OAuth tokens themselves are never env vars — they're minted
# interactively at runtime and stored in the device Keychain/Keystore via
# expo-secure-store (see lib/inat-auth.ts), not in .env.
EXPO_PUBLIC_INATURALIST_OAUTH_CLIENT_ID=your_inaturalist_oauth_client_id

# xeno-canto API v3 key, for species-detail reference call/sound playback
# (lib/species-audio.ts). Register at https://xeno-canto.org, verify your
# email, then grab the key from your account page. Leave blank to just
# always show "unavailable" for that feature — nothing else depends on it.
EXPO_PUBLIC_XENO_CANTO_API_KEY=your_xeno_canto_key
